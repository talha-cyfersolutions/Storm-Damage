# ==============================================================================
# Shared Locations & Reverse Proxy Rules for Storm Damage API
# ==============================================================================

# Allow larger payloads for complex GeoJSON AOI polygons & bounding boxes
client_max_body_size 50M;

# ------------------------------------------------------------------------------
# 1. Healthcheck & Liveness Probes
# Avoid filling access logs with routine container & load-balancer polling
# ------------------------------------------------------------------------------
location ~ ^/(health|health/live|health/ready)$ {
    proxy_pass 16.171.31.245;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    access_log off;
}

# ------------------------------------------------------------------------------
# 2. Cloud-Optimized GeoTIFF (COG) Asset Streaming & Byte-Range Handling
# Required for fast windowed raster reading by Mapbox GL, Leaflet, and QGIS
# ------------------------------------------------------------------------------
location /api/v1/cog/assets/ {
    proxy_pass http://storm_api;
    proxy_http_version 1.1;

    # Explicitly preserve HTTP Range headers
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;

    # Disable proxy buffering so partial byte-range responses stream without memory overhead
    proxy_buffering off;
    proxy_request_buffering off;

    # Proxy headers
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;

    # Streaming timeouts
    proxy_connect_timeout 60s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;

    # Retain upstream Cache-Control headers (public, max-age=86400, immutable)
    proxy_ignore_headers X-Accel-Expires;
}

# ------------------------------------------------------------------------------
# 3. Storm Damage Compute & Primary API Endpoints
# Sentinel-1 SAR change detection and STAC processing can take 60-120 seconds
# ------------------------------------------------------------------------------
location / {
    proxy_pass http://storm_api;
    proxy_http_version 1.1;

    # Forward client IP for rate limiter and audit logging
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;

    # WebSocket support (for Map viewer or real-time event subscriptions)
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Generous timeouts for heavy geospatial compute pipelines
    proxy_connect_timeout 60s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    send_timeout 300s;

    # Buffering configurations
    proxy_buffers 8 64k;
    proxy_buffer_size 128k;
    proxy_busy_buffers_size 128k;
}

